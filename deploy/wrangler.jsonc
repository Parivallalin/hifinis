{
  // hifinis.com website: static files (Cloudflare Pages on Workers). NOT the payment server.
  "name": "hifinis-site",
  "main": "site.js",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "none", "run_worker_first": true },
  "routes": [
    { "pattern": "hifinis.com", "custom_domain": true },
    { "pattern": "www.hifinis.com", "custom_domain": true }
  ]
}
